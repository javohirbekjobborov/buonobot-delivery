BOT_TOKEN=7123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WEBAPP_URL=https://buonobot-delivery-xxx.railway.app
APP_URL=https://buonobot-delivery-xxx.railway.app
ADMIN_IDS=123456789
COURIER_IDS=
# Mini-app initData (Telegram imzosi) amal qilish muddati, soniya. Standart: 86400 (24 soat)
# INITDATA_MAX_AGE_SEC=86400

# ── Yoqilgan funksiyalar (yoqilmaganlari mijozga "Tez orada" bo'lib ko'rinadi) ──
# To'lov usullari: cash, click, payme (vergul bilan). Standart: faqat cash
# PAYMENT_METHODS=cash,payme
# Bonus karta (sovg'a bonus, keshbek, bonus ishlatish). Standart: false
# LOYALTY_ENABLED=true

# ── Yetkazib berish narxi — yo'l (marshrut) masofasi bo'yicha ──
# "gacha_metr:narx" juftlari; oxirgi chegaradan uzoqqa yetkazilmaydi
# DELIVERY_FEES=200:0,1000:7000,3000:12000,5000:15000
# Marshrut xizmati (OSRM, OpenStreetMap). Standart: ochiq server router.project-osrm.org
# OSRM_URL=https://router.project-osrm.org
# OSRM javob bermasa: havo masofasi × shu koeffitsient (taxminiy, guruhda belgilanadi)
# ROUTE_FALLBACK_FACTOR=1.35

# ── Payme (Paycom) Merchant API ──────────────────────────────
# Merchant kabinet: biznes → "Кассы" → kassa → "Настройки" (Merchant ID),
#   "Инструменты разработчика" (Endpoint & Key).
# Merchant kabinetда Endpoint URL sifatida quyidagini kiriting:  <APP_URL>/payme
PAYME_MERCHANT_ID=
PAYME_KEY=          # production kalit
PAYME_TEST_KEY=     # sandbox (test.paycom.uz) kaliti
# PAYME_CHECKOUT_URL=https://checkout.paycom.uz   # ixtiyoriy
# PAYME_ACCOUNT_FIELD=order_id                    # kabinetdagi rekvizit nomi bilan bir xil

# ── iiko Cloud API ───────────────────────────────────────────
IIKO_API_LOGIN=
IIKO_ORGANIZATION_ID=
IIKO_TERMINAL_GROUP_ID=
IIKO_CRM_ENABLED=false
